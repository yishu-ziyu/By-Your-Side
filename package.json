{
  "name": "sideagent",
  "private": true,
  "workspaces": [
    "extension",
    "agent"
  ],
  "scripts": {
    "build": "npm run build -w @sideagent/extension",
    "dev:agent": "tsx agent/src/main.ts --ws",
    "typecheck": "npm run typecheck -w @sideagent/extension && npm run typecheck -w @sideagent/agent",
    "test": "npm run test:unit && npm run test:scale",
    "install:host": "node scripts/install-host.mjs",
    "reload:ext": "node scripts/reload-ext.mjs",
    "capture:clear": "node scripts/clear-voice-capture.mjs",
    "accept:browser": "node scripts/acceptance/run.mjs",
    "accept:team": "node scripts/acceptance/team-run.mjs",
    "accept:sessions": "node scripts/acceptance/session-management-run.mjs",
    "doctor": "tsx scripts/eval/doctor.mts",
    "eval:offline": "tsx scripts/eval/offline.mts",
    "eval:integration": "tsx scripts/eval/integration.mts",
    "eval:live": "tsx scripts/eval/live.mts",
    "eval:report": "tsx scripts/eval/report.mts",
    "release:verify": "tsx scripts/eval/release-verify.mts",
    "check:architecture": "node scripts/maintenance/check-boundaries.mjs",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run build",
    "test:unit": "vitest run --exclude \"agent/test/performance/**\"",
    "test:scale": "vitest run agent/test/performance --maxWorkers=1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
