{
  "name": "sideagent",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "extension",
    "agent"
  ],
  "scripts": {
    "build": "npm run build -w @sideagent/extension",
    "typecheck": "npm run typecheck -w @sideagent/extension && npm run typecheck -w @sideagent/agent",
    "test": "tsx scripts/acceptance/real-path/run-all.mts --core",
    "formal": "node scripts/formal/run.mjs",
    "sim": "tsx --test \"agent/src/**/*.sim.ts\" \"shared/**/*.sim.ts\" \"scripts/**/*.sim.ts\"",
    "reload:ext": "node scripts/reload-ext.mjs",
    "capture:clear": "node scripts/clear-voice-capture.mjs",
    "accept:browser": "node scripts/acceptance/run.mjs",
    "smoke": "tsx scripts/acceptance/real-path/smoke.mts --headless",
    "accept:real-path": "tsx scripts/acceptance/real-path/run-all.mts",
    "accept:shard": "tsx scripts/acceptance/real-path/shard-run.mts",
    "nodes": "tsx scripts/acceptance/nodes-status.mts",
    "check:architecture": "node scripts/checks/check-boundaries.mjs",
    "check:copy": "node scripts/checks/check-copy.mjs",
    "check:motion": "node scripts/checks/check-motion-tokens.mjs",
    "check:style": "node scripts/checks/check-style-tokens.mjs",
    "check:comments": "node scripts/checks/comments.mjs --check",
    "comments:strip": "node scripts/checks/comments.mjs --write",
    "check:complexity": "node scripts/checks/check-complexity.mjs",
    "check:contributors": "node scripts/checks/check-contributors.mjs",
    "check:hardcoded-matching": "node scripts/checks/check-hardcoded-matching.mjs",
    "check:code": "npm run check:contributors && npm run check:hardcoded-matching && npm run check:comments && npm run check:complexity && npm run typecheck && npm run build",
    "check:ui": "npm run check:style && npm run check:motion",
    "dashboard": "node scripts/maintenance/dashboard.mjs",
    "check:all": "npm run check:copy && npm run check:ui && npm run check:architecture && npm run check:code",
    "check": "npm run check:code",
    "runs": "node scripts/maintenance/runs.mjs",
    "task": "node scripts/maintenance/task.mjs",
    "kimi:login": "NODE_USE_ENV_PROXY=1 node scripts/maintenance/kimi-login.mjs --login",
    "kimi:keep": "NODE_USE_ENV_PROXY=1 node scripts/maintenance/kimi-login.mjs --install",
    "lines": "node scripts/maintenance/lines.mjs",
    "dev:flow": "node scripts/maintenance/dev-pipeline.mjs",
    "dev:atlas": "node scripts/maintenance/dev-atlas.mjs",
    "accept:report": "node scripts/maintenance/acceptance-report.mjs",
    "logs": "node scripts/maintenance/logs.mjs",
    "memory:report": "node scripts/maintenance/memory-report.mjs",
    "self-use": "node scripts/maintenance/self-use.mjs",
    "self-use:review": "tsx scripts/maintenance/ux-findings.mts",
    "climb": "tsx scripts/maintenance/climb.mts",
    "lab": "node scripts/maintenance/lab.mjs",
    "gallery": "node scripts/maintenance/lab.mjs gallery",
    "frames": "tsx scripts/acceptance/real-path/recording.mts",
    "gym": "tsx scripts/gym/run.mts",
    "gym:report": "node scripts/gym/report.mjs",
    "gym:replay": "node scripts/gym/replay.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "marked": "18.0.11",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
