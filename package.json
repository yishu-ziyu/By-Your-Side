{
  "name": "sideagent",
  "private": true,
  "workspaces": [
    "extension",
    "agent"
  ],
  "scripts": {
    "build": "npm run build -w @sideagent/extension",
    "typecheck": "npm run typecheck -w @sideagent/extension && npm run typecheck -w @sideagent/agent",
    "test": "tsx scripts/acceptance/real-path/run-all.mts --core",
    "reload:ext": "node scripts/reload-ext.mjs",
    "capture:clear": "node scripts/clear-voice-capture.mjs",
    "accept:browser": "node scripts/acceptance/run.mjs",
    "smoke": "tsx scripts/acceptance/real-path/smoke.mts --headless",
    "accept:real-path": "tsx scripts/acceptance/real-path/run-all.mts",
    "check:architecture": "node scripts/maintenance/check-boundaries.mjs",
    "check:docs": "node scripts/maintenance/check-docs.mjs",
    "check:copy": "node scripts/maintenance/check-copy.mjs",
    "check:motion": "node scripts/maintenance/check-motion-tokens.mjs",
    "dashboard": "node scripts/maintenance/dashboard.mjs",
    "check": "npm run check:docs && npm run check:copy && npm run check:motion && npm run check:architecture && npm run typecheck && npm run build",
    "runs": "node scripts/maintenance/runs.mjs",
    "task": "node scripts/maintenance/task.mjs",
    "kimi:login": "NODE_USE_ENV_PROXY=1 node scripts/maintenance/kimi-login.mjs --login",
    "kimi:keep": "NODE_USE_ENV_PROXY=1 node scripts/maintenance/kimi-login.mjs --install",
    "lines": "node scripts/maintenance/lines.mjs",
    "logs": "node scripts/maintenance/logs.mjs",
    "lab": "node scripts/maintenance/lab.mjs",
    "gym": "tsx scripts/gym/run.mts",
    "gym:report": "node scripts/gym/report.mjs",
    "gym:replay": "node scripts/gym/replay.mjs"
  },
  "devDependencies": {
    "marked": "18.0.11",
    "playwright": "1.58.2",
    "typescript": "7.0.2"
  }
}
