{
  "maxChars": 12000,
  "maxLines": 300,
  "entryLimits": {
    "README.md": 3000,
    "AGENTS.md": 6000,
    "docs/README.md": 3000,
    "docs/STATUS.md": 5000,
    "docs/NOTES.md": 3500
  },
  "historicalPrefixes": ["docs/history/", "docs/evals/", "docs/tasks/", "docs/work/", "docs/reviews/", "docs/diagnostics/", "docs/research/", "docs/evidence/", "docs/previews/", "docs/devlog/"],
  "locationExceptions": {
    "README.md": "仓库概览与文档目录",
    "AGENTS.md": "编码代理自动读取的规则入口",
    "CLAUDE.md": "Claude Code 自动读取的入口，只导入 AGENTS.md",
    ".github/pull_request_template.md": "GitHub 自动读取的复核入口",
    ".agents/skills/typesafe-ai/SKILL.md": "工具技能加载约定",
    ".kimi-code/agents/consolidator.md": "已有代理角色加载入口",
    "agent/src/vendor/stagehand/PATCH.md": "随第三方源码保留的补丁来源",
    "tools/oxlint/anti-slop/VENDOR.md": "随第三方源码保留的版本来源",
    "tools/oxlint/anti-slop/src/vendor/eslint-stylistic/UPSTREAM.md": "上游授权与来源说明",
    "eval/protected/README.md": "锁定评测原件，不随候选实现迁移",
    "eval/protected/CODEX_EXECUTION_SPEC.md": "锁定评测原件，不随候选实现迁移",
    "eval/protected/REVIEW_EVIDENCE.md": "锁定评测原件，不随候选实现迁移"
  },
  "syncRules": [
    {"name": "文档与开发工具", "sources": ["^scripts/maintenance/", "^scripts/acceptance/.*documentation", "^scripts/acceptance/wiki-", "^\\.kimi-code/", "^\\.github/", "^package(-lock)?\\.json$"], "documents": ["docs/development/documentation.md", "docs/development/checks.md"]},
    {"name": "安装与构建", "sources": ["^scripts/install", "^scripts/reload", "^extension/(build\\.mjs|manifest\\.json|package\\.json)$", "^agent/package\\.json$"], "documents": ["docs/guides/getting-started.md"]},
    {"name": "语音与派发", "sources": ["^agent/src/(voice|realtime|streaming|route-shadow)", "^extension/src/(sidepanel/voice|background/voice)", "^shared/voice"], "documents": ["docs/voice-architecture.md", "docs/voice-dispatch.md"]},
    {"name": "阅读与翻译", "sources": ["^agent/src/(reading|page-translation|display-)", "^extension/src/(content/ask|shared/(reading|page-translation))", "^shared/(reading|page-translation)"], "documents": ["docs/reading-appearance.md", "docs/protocol.md"]},
    {"name": "浏览器与共享契约", "sources": ["^extension/src/(background|content)/", "^shared/", "^agent/src/(tools|rpc|browser-)"], "documents": ["docs/protocol.md", "docs/browser-program.md"]},
    {"name": "侧栏交互", "sources": ["^extension/src/", "^extension/.*\\.(html|css)$"], "documents": ["docs/human-ai-contract.md", "docs/guides/usage.md"]},
    {"name": "运行时与记忆", "sources": ["^agent/src/", "^scripts/everos/"], "documents": ["docs/architecture.md", "docs/integrations/everos.md"]},
    {"name": "验收工具", "sources": ["^scripts/"], "documents": ["docs/testing/acceptance.md", "docs/development/checks.md"]}
  ]
}
