        "code": "(() => {\n  const all = document.querySelectorAll('*');\n  const hits = [];\n  for (const el of all) {\n    if (el.children.length === 0 && el.textContent && el.textContent.trim() === 'river-flash-4900') {\n      const path = [];\n      let n = el;\n      while (n && n.nodeType === 1) {\n        let seg = n.tagName.toLowerCase();\n        if (n.id) seg += '#' + n.id;\n        else if (n.className && typeof n.className === 'string') {\n          const cls = n.className.trim().split(/\\s+/).filter(Boolean).slice(0,2).join('.');\n          if (cls) seg += '.' + cls;\n        }\n        path.unshift(seg);\n        if (path.length > 8) break;\n        n = n.parentElement;\n      }\n      hits.push({tag: el.tagName, text: el.textContent.trim(), path: path.join(' > ')});\n    }\n  }\n  return hits;\n})()"
