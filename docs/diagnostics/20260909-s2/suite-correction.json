        "code": "(() => {\n  // 找到标准模型ID所在的文本节点/元素的唯一选择器\n  const all = document.body.querySelectorAll('*');\n  const matches = [];\n  for (const el of all) {\n    if (el.children.length === 0 && el.textContent && el.textContent.trim() === 'river-flash-9197') {\n      matches.push({\n        tag: el.tagName,\n        cls: el.className,\n        text: el.textContent,\n        id: el.id,\n        // 生成从最近有id/可识别祖先开始的相对路径\n        parentTag: el.parentElement && el.parentElement.tagName,\n        parentCls: el.parentElement && el.parentElement.className,\n      });\n    }\n  }\n  return matches;\n})()"
