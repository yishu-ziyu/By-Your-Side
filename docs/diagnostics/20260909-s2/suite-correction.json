    {
      "name": "js",
      "params": {
        "code": "(() => {\n  const all = document.body.querySelectorAll('*');\n  for (const el of all) {\n    if (el.children.length === 0 && el.textContent && el.textContent.trim() === 'river-flash-9197') {\n      // 找祖先里有 id 或唯一 data-* 的路径\n      let path = [];\n      let cur = el;\n      while (cur && cur !== document.body) {\n        let part = cur.tagName.toLowerCase();\n        if (cur.id) { part += '#' + cur.id; path.unshift(part); break; }\n        if (cur.dataset && Object.keys(cur.dataset).length) {\n          const k = Object.keys(cur.dataset)[0];\n          part += `[data-${k}=\"${cur.dataset[k]}\"]`;\n        } else {\n          // 在兄弟节点中的位置\n          const parent = cur.parentElement;\n          if (parent) {\n            const sibs = Array.from(parent.children).filter(c => c.tagName === cur.tagName);\n            if (sibs.length > 1) part += `:nth-of-type(${sibs.indexOf(cur)+1})`;\n          }\n        }\n        path.unshift(part);\n        cur = cur.parentElement;\n      }\n      return {\n        css: path.join(' > '),\n        outerHTML: el.outerHTML,\n        parentOuter: el.parentElement.outerHTML.slice(0, 300)\n      };\n    }\n  }\n  return null;\n})()"
      },
