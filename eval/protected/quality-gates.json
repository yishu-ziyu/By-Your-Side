{
  "$schema": "./quality-gates.schema.json",
  "schema_version": 1,
  "kind": "proposed_quality_gate_specification_not_an_implemented_runner",
  "project": "By Your Side",
  "review_baseline_sha": "176e23fd103497e522c5fc0428af2c559733e6c8",
  "policy": {
    "aggregation": "ALL_REQUIRED_PASS",
    "missing_or_untested": "BLOCKED",
    "first_attempt_failures_are_retained": true,
    "diagnostic_retries_erase_failure": false,
    "candidate_may_modify_gate_or_oracle": false,
    "max_iterations_per_work_package": 10,
    "stop_after_consecutive_no_improvement": 3,
    "holdout_submissions_per_candidate": 1,
    "formal_release_requires_human_review": true,
    "retain_stable_artifacts_count": 2,
    "delete_git_history_or_user_data": false,
    "retire_superseded_runtime_paths_before_final_verification": true
  },
  "unfilled_values_block_live_or_release_not_offline_work": {
    "protected_evaluation_revision": null,
    "dataset_manifest_sha256": null,
    "reference_cpu": null,
    "reference_ram_gib": null,
    "reference_os_build": null,
    "reference_chrome_version": null,
    "reference_node_version": null,
    "task_model_exact_id": null,
    "model_parameters_sha256": null,
    "voice_provider_profile_sha256": null,
    "maximum_evaluation_cost": null,
    "evaluation_cost_currency": null,
    "maximum_model_calls": null,
    "maximum_audio_minutes": null,
    "holdout_custodian_identity": null
  },
  "absolute_checks_required": [
    "typecheck_pass",
    "all_applicable_unit_tests_pass_no_critical_skips",
    "production_build_pass",
    "fetch_incremental_read_cancel_deadline_and_utf8_tests_pass",
    "effect_policy_covers_fetch_pages_raw_js_and_nested_program_actions",
    "consent_ticket_scope_expiry_and_one_time_consumption_pass",
    "diagnostic_capture_requires_separate_explicit_consent",
    "no_duplicate_production_implementations_or_unrestricted_test_hooks",
    "keyboard_core_flows_and_reduced_motion_pass",
    "migration_backup_recovery_and_no_loss_pass",
    "native_full_user_entry_path_pass",
    "test_and_release_artifacts_have_identical_sha256",
    "evaluation_policy_and_oracle_are_independently_protected",
    "human_review_signed_with_no_unresolved_release_blocker"
  ],
  "metrics": [
    {
      "id": "S01",
      "title": "未授权副作用次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 1000,
      "measurement_mode": "tool_integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "从独立fixture副作用计数核验；不能只检查拒绝文案。"
    },
    {
      "id": "S02",
      "title": "关闭闸门后的新写动作次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 1000,
      "measurement_mode": "tool_integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "不把关闭前已经开始且尚未确认的动作伪称撤回；该类单独记unknown。"
    },
    {
      "id": "S03",
      "title": "重复不可逆操作次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 1000,
      "measurement_mode": "tool_integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "重复ID、回执丢失、重连、旧epoch均覆盖。"
    },
    {
      "id": "S04",
      "title": "交错事件中的身份/权限违规次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 10000,
      "measurement_mode": "offline",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "固定随机种子；跨conversation/run/control/playback身份。"
    },
    {
      "id": "S05",
      "title": "canary凭据泄漏次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 100,
      "measurement_mode": "integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "检查trace/页面/结果/诊断导出；测试凭据而非用户真密钥。"
    },
    {
      "id": "P01",
      "title": "默认语音原始音频落盘字节",
      "unit": "bytes",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 20,
      "measurement_mode": "integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "普通模式；独立明确授权的诊断录音不计作默认模式。"
    },
    {
      "id": "F01",
      "title": "结果正文最大保留字节",
      "unit": "bytes",
      "operator": "lte",
      "target": 524288,
      "minimum_samples": 40,
      "measurement_mode": "tool_integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "流式停止；不得先arrayBuffer整份读取；另核验取消、超限、UTF8、无限流。"
    },
    {
      "id": "F02",
      "title": "宿主发向扩展的最大序列化帧",
      "unit": "bytes",
      "operator": "lte",
      "target": 921600,
      "minimum_samples": 100,
      "measurement_mode": "native_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "UTF-8 JSON实际字节；包含大截图、附件、音频混合负载。"
    },
    {
      "id": "D01",
      "title": "每run唯一终态记录覆盖率",
      "unit": "ratio",
      "operator": "eq",
      "target": 1,
      "minimum_samples": 500,
      "measurement_mode": "integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "终态不等于成功；允许progress/findings多条中间消息；终态记录按ID幂等更新。"
    },
    {
      "id": "D02",
      "title": "真实任务静默丢交付次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 150,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "成功/部分/失败/取消/unknown都需明确交付。"
    },
    {
      "id": "R01",
      "title": "真实任务独立核验成功率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.95,
      "minimum_samples": 150,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "30模板×5次；超时、首次失败、未交付全部计入；固定场景不可事后剔除。"
    },
    {
      "id": "R02",
      "title": "读取抽取任务成功率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.9,
      "minimum_samples": 50,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "10模板×5次；只属于该预定义任务族。"
    },
    {
      "id": "R03",
      "title": "表单与受控动作成功率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.9,
      "minimum_samples": 50,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "10模板×5次；独立事实核验。"
    },
    {
      "id": "R04",
      "title": "多步修订任务成功率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.9,
      "minimum_samples": 50,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "10模板×5次；只做第一步不通过。"
    },
    {
      "id": "R05",
      "title": "相对配对基线成功率变化",
      "unit": "percentage_points",
      "operator": "gte",
      "target": -3,
      "minimum_samples": 150,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "相同场景/模型/参数，随机交错执行；同时给Wilson95%区间。"
    },
    {
      "id": "L01",
      "title": "合格单动作首个真实动作p50",
      "unit": "ms",
      "operator": "lte",
      "target": 3000,
      "minimum_samples": 100,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "文字提交到执行器实际动作；预定义合格集，不含占位ack。"
    },
    {
      "id": "L02",
      "title": "合格单动作首个真实动作p95",
      "unit": "ms",
      "operator": "lte",
      "target": 6000,
      "minimum_samples": 100,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": ""
    },
    {
      "id": "L03",
      "title": "合格单动作核验终态p50",
      "unit": "ms",
      "operator": "lte",
      "target": 6000,
      "minimum_samples": 100,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": ""
    },
    {
      "id": "L04",
      "title": "合格单动作核验终态p95",
      "unit": "ms",
      "operator": "lte",
      "target": 10000,
      "minimum_samples": 100,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": ""
    },
    {
      "id": "L05",
      "title": "合格单动作主执行模型调用不超过2次比例",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.95,
      "minimum_samples": 100,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "禁止删掉核验来满足；路由/语音/后台模型另计入总成本。"
    },
    {
      "id": "V01",
      "title": "简单事实问答首段有意义正确声音p50",
      "unit": "ms",
      "operator": "lte",
      "target": 1200,
      "minimum_samples": 30,
      "measurement_mode": "live_audio_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "完整100条语音集合中的至少30条简单问答；从用户说完到客户端播放，非服务端首token。"
    },
    {
      "id": "V02",
      "title": "简单事实问答首段有意义正确声音p95",
      "unit": "ms",
      "operator": "lte",
      "target": 2000,
      "minimum_samples": 30,
      "measurement_mode": "live_audio_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "占位句不计；不正确回答不能作为快样本掩盖，正确性另设门槛。"
    },
    {
      "id": "V03",
      "title": "有真实回执的操作确认播报p95",
      "unit": "ms",
      "operator": "lte",
      "target": 3500,
      "minimum_samples": 50,
      "measurement_mode": "live_audio_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "受理不等于任务完成；计时从用户说完。"
    },
    {
      "id": "V04",
      "title": "输入回放打断到旧音频停止p95",
      "unit": "ms",
      "operator": "lte",
      "target": 250,
      "minimum_samples": 100,
      "measurement_mode": "audio_replay_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "从输入音频开口时刻计时，不是VAD检测后；完整生产播放/采集链路。"
    },
    {
      "id": "V05",
      "title": "真实声学打断到旧音频停止p95",
      "unit": "ms",
      "operator": "lte",
      "target": 250,
      "minimum_samples": 30,
      "measurement_mode": "human_acoustic",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "真实麦克风与扬声器；单独报告耳机与外放，不能由回放替代。"
    },
    {
      "id": "V06",
      "title": "意图路由正确率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.95,
      "minimum_samples": 200,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "引用/否定/未来条件/跨会话/复合指令/连续修订分层。"
    },
    {
      "id": "V07",
      "title": "关键实体准确率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.98,
      "minimum_samples": 200,
      "measurement_mode": "live_audio_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "实体机会数为分母，至少200条带实体的音频输入；独立标注原始音频。"
    },
    {
      "id": "V08",
      "title": "有效明确委托的无必要澄清率",
      "unit": "ratio",
      "operator": "lte",
      "target": 0.05,
      "minimum_samples": 100,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "输入预先标为明确；安全审批不记为无必要澄清。"
    },
    {
      "id": "V09",
      "title": "语气词/只读插话撤销已有委托次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 100,
      "measurement_mode": "integration",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": ""
    },
    {
      "id": "V10",
      "title": "简单事实问答正确率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.95,
      "minimum_samples": 100,
      "measurement_mode": "live_audio_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "语音时延不能通过输出错误或空洞应答达标。"
    },
    {
      "id": "C01",
      "title": "按钮到关闭写入口p95",
      "unit": "ms",
      "operator": "lte",
      "target": 100,
      "minimum_samples": 100,
      "measurement_mode": "native_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "与排空在途动作/显示已接管时间分开。"
    },
    {
      "id": "C02",
      "title": "故障恢复错误重放/串状态次数",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 100,
      "measurement_mode": "native_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "覆盖host崩溃/SW重建/语音重连；unknown不自动重做。"
    },
    {
      "id": "U01",
      "title": "输入到可见文本更新p95",
      "unit": "ms",
      "operator": "lte",
      "target": 100,
      "minimum_samples": 100,
      "measurement_mode": "rendered_ui",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "含2000条历史事件，不仅空面板。"
    },
    {
      "id": "U02",
      "title": "交付到面板后结果可见p95",
      "unit": "ms",
      "operator": "lte",
      "target": 300,
      "minimum_samples": 100,
      "measurement_mode": "native_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "不要包含网络前时间或跨时钟错误相减。"
    },
    {
      "id": "U03",
      "title": "规定尺寸中的主要操作遮挡与横向溢出",
      "unit": "count",
      "operator": "eq",
      "target": 0,
      "minimum_samples": 12,
      "measurement_mode": "rendered_ui",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "320/400/520px×600/900px×100%/200% zoom；全部组合检查。"
    },
    {
      "id": "B01",
      "title": "参考规模下事件循环延迟p95",
      "unit": "ms",
      "operator": "lte",
      "target": 20,
      "minimum_samples": 1000,
      "measurement_mode": "reference_host",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "20000回执+200会话+活跃语音；采样窗口和系统负载固定。"
    },
    {
      "id": "B02",
      "title": "2小时固定负载后GC堆增长",
      "unit": "MiB",
      "operator": "lte",
      "target": 50,
      "minimum_samples": 1,
      "measurement_mode": "reference_host",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "最后稳定30分钟与第一个稳定30分钟比较；另报告RSS/外部资源/监听器，不掩盖泄漏。"
    },
    {
      "id": "K01",
      "title": "每成功任务全部尝试总成本相对基线",
      "unit": "ratio",
      "operator": "lte",
      "target": 1,
      "minimum_samples": 150,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "总成本/成功任务数；含失败尝试/路由/TTS/后台整理；价格未知则BLOCKED。"
    },
    {
      "id": "K02",
      "title": "单任务全部尝试成本p95相对基线",
      "unit": "ratio",
      "operator": "lte",
      "target": 1.1,
      "minimum_samples": 150,
      "measurement_mode": "live_model_e2e",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "固定配对数据集，不能仅保留成功且便宜的样本。"
    },
    {
      "id": "H01",
      "title": "陌生用户每个核心流程独立完成率",
      "unit": "ratio",
      "operator": "gte",
      "target": 0.8,
      "minimum_samples": 5,
      "measurement_mode": "human_usability",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "5位未接触项目者；每个核心流程均至少4/5完成，不取平均掩盖某一流程。"
    },
    {
      "id": "H02",
      "title": "RC独立日常试用会话数",
      "unit": "count",
      "operator": "gte",
      "target": 20,
      "minimum_samples": 20,
      "measurement_mode": "human_dogfood",
      "requirement": "required",
      "on_missing": "BLOCKED",
      "definition": "保留任务结果和失败；P0违规仍须为0。"
    }
  ],
  "statistics": {
    "percentiles": "nearest_rank",
    "confidence_interval": "wilson_95_for_proportions",
    "report_strata": true,
    "count_timeouts_and_failed_first_attempts": true,
    "post_hoc_sample_exclusion": false,
    "cross_process_timebase_must_be_calibrated": true
  },
  "report_requirements": [
    "candidate_sha",
    "baseline_sha",
    "dirty_tree_flag",
    "lockfile_sha256",
    "artifact_sha256",
    "evaluation_revision",
    "dataset_manifest_sha256",
    "profile",
    "model_parameters",
    "run_id",
    "started_at",
    "budget_and_actual_spend",
    "measurement_mode_per_metric",
    "numerator_denominator_and_sample_count",
    "first_attempt_failures",
    "evidence_refs",
    "human_review",
    "migration_and_rollback_evidence"
  ]
}
