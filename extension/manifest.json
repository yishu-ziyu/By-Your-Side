{
  "manifest_version": 3,
  "name": "SideAgent",
  "version": "0.1.0",
  "description": "侧边栏 Agent：连接本地伴随进程，替你操作浏览器。",
  "permissions": ["debugger", "tabs", "scripting", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "SideAgent"
  }
}
