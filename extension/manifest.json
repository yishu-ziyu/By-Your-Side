{
  "manifest_version": 3,
  "name": "SideAgent",
  "version": "0.1.0",
  "description": "侧边栏 Agent：连接本地伴随进程，替你操作浏览器。",
  "permissions": ["debugger", "tabs", "scripting", "sidePanel", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SideAgent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
