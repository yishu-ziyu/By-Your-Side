#!/bin/sh
# Reject lint violations that are new in this commit.
#
# Installed with: git config core.hooksPath scripts/git-hooks
# Keep it fast. One side effect: blank-line spacing in fully staged files is
# fixed and re-staged (see scripts/lint-changed.mjs); nothing else is rewritten.
#
# Escape hatch for a one-off commit that must land as-is:
#   git commit --no-verify
# Using it skips every gate, so say why in the commit message.

node scripts/lint-changed.mjs --staged
