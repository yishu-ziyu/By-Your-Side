/** Real extension settings and dictation. Step Plan uses real ASR and a known synthetic Chinese WAV.
 * npx tsx scripts/acceptance/real-path/dictation-providers.mts --headless
 * --headed opens an isolated background browser. SiliconFlow success requires SILICONFLOW_API_KEY.
 */
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { mkdir, readFile, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { join } from "node:path";
import { startScriptedModel } from "./scripted-model.mts";
import { REPO, launchRealPath, sleep, until } from "./harness.mts";
const out = join(REPO, "out/acceptance/real-path", `${new Date().toISOString().replace(/[:.]/g, "-")}-dictation-providers`);
await mkdir(out, { recursive: true });
const phrase = "请帮我整理这篇文章的三个重点";
const wav = join(out, "microphone.wav");
execFileSync("say", ["-v", "Tingting", "-o", wav, "--data-format=LEI16@24000", `[[slnc 600]]${phrase}[[slnc 600]]`]);
const speechMs = Math.ceil((await readFile(wav)).length / 48);
const key = (await readFile(join(homedir(), ".sideagent/step-plan.key"), "utf8")).trim();
const model = await startScriptedModel([{ match: "*", steps: [{ text: "本轮没有发送消息" }] }]);
const rp = await launchRealPath({ microphoneWav: wav, headed: process.argv.includes("--headed"), chromeArgs: ["--autoplay-policy=no-user-gesture-required"] });
const checked: string[] = [];
const unavailable = process.argv.includes("--service-unavailable");
const unverified = ["Chrome 真正识别音源尚未受控，不能以任何非空转写判断成功", "真人语音与日常 Chrome 尚未验证"];
let settings = "";
let panel = "";
let error: string | null = null;
const click = async (session: string, selector: string) => {
  await rp.evaluate(session, `document.querySelector(${JSON.stringify(selector)}).scrollIntoView({block:'center'})`);
  assert.ok(await rp.evaluate(session, `document.querySelector(${JSON.stringify(selector)}).checkVisibility()`), `不可见 ${selector}`);
  await rp.click(session, selector);
};
const fill = async (session: string, selector: string, value: string) => {
  await click(session, selector);
  await rp.evaluate(session, `document.querySelector(${JSON.stringify(selector)}).select()`);
  await rp.typeText(session, value);
};
const text = (selector: string) => rp.evaluate(settings, `document.querySelector(${JSON.stringify(selector)}).textContent`);
const choose = async (value: string) => {
  await click(settings, "#dictation-provider");
  await rp.cdp.send("Input.dispatchKeyEvent", { type: "keyDown", key: "Escape", code: "Escape", windowsVirtualKeyCode: 27 }, settings);
  await rp.evaluate(settings, `(() => { const select = document.querySelector('#dictation-provider'); select.value = ${JSON.stringify(value)}; select.dispatchEvent(new Event('change', {bubbles:true})); })()`);
  await until(async () => await rp.evaluate(settings, `document.querySelector('#dictation-provider').value === ${JSON.stringify(value)}`) || undefined, 3000, "选择识别服务");
  await sleep(150);
};
const save = async () => { await click(settings, "#dictation-save"); await until(async () => String(await text("#dictation-status")).startsWith("已保存") || undefined, 3000, "保存识别设置"); };
const draft = () => rp.evaluate(panel, "document.querySelector('#input').value");
try {
  const target = await rp.cdp.send("Target.createTarget", { url: `chrome-extension://${rp.extensionId}/settings.html#voice`, background: true });
  settings = await rp.attach(target.targetId);
  await until(async () => await rp.evaluate(settings, `!!document.querySelector('#dictation-provider')`) || undefined, 15000, "设置页");
  await rp.evaluate(settings, `chrome.storage.local.set({inproc_voice_key:'voice-isolation-sentinel',inproc_model_config:{provider:'custom',modelId:'dictation-check',baseUrl:${JSON.stringify(model.baseUrl)}},'inproc_cred:custom':{type:'api_key',key:'local-only',env:{SIDEAGENT_CUSTOM_ENDPOINT:${JSON.stringify(model.baseUrl)}}}})`);
  await rp.screenshot(settings, join(out, "01-chrome.png"));
  await choose("stepfun");
  await fill(settings, "#dictation-key", "invalid-acceptance-key");
  await click(settings, "#dictation-test");
  await until(async () => await rp.evaluate(settings, `document.querySelector('#dictation-status').dataset.tone === 'err'`) || undefined, 35000, "真实服务拒绝无效密钥");
  assert.match(String(await text("#dictation-status")), /密钥|权限/);
  assert.equal(await rp.evaluate(settings, "chrome.storage.local.get('dictation_config').then(s => s.dictation_config ?? null)"), null, "测试不保存");
  checked.push("Step Plan 真实服务拒绝错误密钥，测试不保存");
  await fill(settings, "#dictation-key", key);
  await click(settings, "#dictation-test");
  await until(async () => await rp.evaluate(settings, `!document.querySelector('#dictation-test').disabled`) || undefined, 35000, "真实连接测试");
  assert.match(String(await text("#dictation-status")), unavailable ? /不可用|权限|套餐/ : /连接成功/);
  await save();
  assert.equal(await rp.evaluate(settings, "chrome.storage.local.get('inproc_voice_key').then(s=>s.inproc_voice_key ?? null)"), "voice-isolation-sentinel", "不改右侧语音凭据");
  await rp.screenshot(settings, join(out, "02-stepfun-saved.png"));
  checked.push(unavailable ? "Step Plan 真实服务不可用提示与保存，语音对话凭据未变" : "Step Plan 静音真实连接测试与保存，语音对话凭据未变");
  if (unavailable) unverified.push("Step Plan 当前凭据返回 model_invalid，真实识别成功路径未通过");
  const secondTarget = await rp.cdp.send("Target.createTarget", { url: `chrome-extension://${rp.extensionId}/settings.html#voice`, newWindow: true, background: true });
  const second = await rp.attach(secondTarget.targetId);
  await until(async () => await rp.evaluate(second, `document.querySelector('#dictation-provider')?.value === 'stepfun'`) || undefined, 15000, "另一窗口重新读取设置");
  checked.push("另一窗口打开后选择仍为 Step Plan");
  await fill(settings, "#dictation-key", key + "-draft"); await save();
  await until(async () => await rp.evaluate(second, `document.querySelector('#dictation-status').textContent.includes('其他窗口')`) || undefined, 5000, "旧窗口提示冲突");
  await click(second, "#dictation-save");
  await until(async () => await rp.evaluate(second, `document.querySelector('#dictation-status').textContent.includes('重新打开此页后再保存')`) || undefined, 3000, "旧窗口明确拒绝覆盖");
  assert.equal(await rp.evaluate(second, `chrome.storage.local.get('dictation_key:stepfun').then(s=>s['dictation_key:stepfun'].endsWith('-draft'))`), true, "旧窗口不能覆盖新凭据");
  await fill(settings, "#dictation-key", key); await save();
  checked.push("旧设置窗口不能覆盖其他窗口保存的新凭据");
  await rp.cdp.send("Target.closeTarget", { targetId: secondTarget.targetId });
  panel = await rp.attach(await rp.openSidePanel());
  await until(async () => await rp.evaluate(panel, `!!document.querySelector('#dictate-btn')`) || undefined, 15000, "左侧麦克风");
  await fill(panel, "#input", "原草稿：");
  await click(panel, "#dictate-btn");
  await until(async () => await rp.evaluate(panel, `document.querySelector('.dictation-hint').textContent.includes('说完出字')`) || undefined, 10000, "真实麦克风录音");
  assert.equal(await rp.evaluate(panel, "document.querySelector('.voice-start').checkVisibility()"), false, "录音时语音对话按钮不可见");
  assert.equal(await rp.evaluate(panel, "document.querySelector('#send-btn').checkVisibility()"), false, "录音时发送按钮不可见");
  await sleep(speechMs + 500);
  await rp.screenshot(panel, join(out, "03-recording.png"));
  await click(panel, ".dictation-ok");
  const messagesBefore = await rp.evaluate(panel, "document.querySelectorAll('.msg.user').length");
  await click(panel, ".voice-start");
  await until(async () => await rp.evaluate(panel, "document.body.innerText.includes('说话输入正在用麦克风')") || undefined, 3000, "等待转写时阻止语音对话");
  await click(panel, "#send-btn");
  await until(async () => await rp.evaluate(panel, "document.body.innerText.includes('请先结束说话输入')") || undefined, 3000, "等待转写时拒绝发送提示");
  assert.equal(await rp.evaluate(panel, "document.querySelectorAll('.msg.user').length"), messagesBefore, "没有新增用户消息");
  await until(async () => await rp.evaluate(panel, `!document.querySelector('#dictate-btn').disabled`) || undefined, 35000, "真实中文识别完成");
  const result = String(await draft());
  assert.ok(result.startsWith("原草稿："), "原草稿保留");
  if (unavailable) {
    assert.equal(result, "原草稿：", "真实服务失败保留草稿");
    assert.match(String(await rp.evaluate(panel, "document.body.innerText")), /不可用|权限|套餐/);
  } else assert.ok(result.includes("整理") && result.includes("文章") && result.includes("三个重点"), `受控音频识别应匹配已知句子，得到 ${result}`);
  await rp.screenshot(panel, join(out, "04-transcribed.png"));
  checked.push(unavailable ? "合成音频经真实麦克风上传，真实 Step Plan 拒绝时保留草稿" : `合成音频 → 真实 Step Plan → 草稿：${result}`);
  await click(panel, "#dictate-btn");
  await until(async () => await rp.evaluate(panel, `document.querySelector('.dictation-hint').textContent.includes('说完出字')`) || undefined, 10000, "取消前录音");
  await click(panel, ".dictation-cancel");
  assert.equal(await draft(), result, "取消不改变草稿");
  checked.push("取消保留原草稿、听写期间禁止发送和开启语音对话");
  await click(panel, "#dictate-btn");
  await until(async () => await rp.evaluate(panel, `document.querySelector('.dictation-hint').textContent.includes('说完出字')`) || undefined, 10000, "切会话前录音");
  await click(panel, "#conversation-new");
  await until(async () => await rp.evaluate(panel, `!document.querySelector('#composer').classList.contains('dictating')`) || undefined, 10000, "切会话取消录音");
  assert.equal(await draft(), "", "新会话不写入旧草稿");
  await fill(panel, "#input", result);
  checked.push("录音中切会话取消，旧草稿不写进新会话");
  await choose("siliconflow");
  await fill(settings, "#dictation-key", process.env.SILICONFLOW_API_KEY ?? "invalid-acceptance-key");
  await click(settings, "#dictation-test");
  await until(async () => await rp.evaluate(settings, `!document.querySelector('#dictation-test').disabled`) || undefined, 35000, "硅基流动真实接口返回");
  if (!process.env.SILICONFLOW_API_KEY) {
    assert.equal(await rp.evaluate(settings, `document.querySelector('#dictation-status').dataset.tone`), "err");
    unverified.push("硅基流动无有效凭据，仅验证真实接口拒绝无效凭据，未验证识别成功");
  } else assert.match(String(await text("#dictation-status")), /连接成功/);
  await save();
  await rp.screenshot(settings, join(out, "05-siliconflow.png"));
  await fill(settings, "#dictation-key", ""); await save();
  await click(panel, "#dictate-btn"); await sleep(500);
  assert.equal(await rp.evaluate(panel, `document.querySelector('#composer').classList.contains('dictating')`), false);
  assert.equal(await draft(), result);
  checked.push("硅基流动配置与清除、缺少密钥不录音且保留草稿");
  await choose("chrome"); await save();
  await click(settings, "#dictation-test");
  await until(async () => await rp.evaluate(settings, `!document.querySelector('#dictation-test').disabled`) || undefined, 5000, "Chrome 能力检查");
  assert.match(String(await text("#dictation-status")), /浏览器支持/);
  checked.push("Chrome 能力与权限检查，独立选择保存");
  await rp.cdp.send("Emulation.setEmulatedMedia", { features: [{ name: "prefers-color-scheme", value: "dark" }, { name: "prefers-reduced-motion", value: "reduce" }] }, settings);
  await rp.screenshot(settings, join(out, "06-dark-reduced-motion.png"));
} catch (cause) {
  error = cause instanceof Error ? cause.message.replaceAll(key, "[REDACTED]") : String(cause);
  if (settings) await rp.screenshot(settings, join(out, "failure-settings.png")).catch(() => {});
  if (panel) await rp.screenshot(panel, join(out, "failure-panel.png")).catch(() => {});
} finally {
  await rp.close(); await rp.remove(); await model.close();
  await writeFile(join(out, "result.json"), JSON.stringify({ ok: !error, mode: unavailable ? "failure-path-only" : "live-asr", checked, unverified, error, audio: "macOS Tingting synthetic Chinese WAV", phrase }, null, 2));
}
console.log(JSON.stringify({ ok: !error, out, checked, unverified, error }, null, 2));
if (error) process.exitCode = 1;
