import assert from "node:assert/strict";
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { launchRealPath, REPO, requireHeadless, sleep, until } from "./harness.mts";
import { startScriptedModel } from "./scripted-model.mts";

requireHeadless();
const out = join(REPO, "out/acceptance/real-path", `${new Date().toISOString().replace(/[:.]/g, "-")}-starter-demo`);
await mkdir(out, { recursive: true });
const model = await startScriptedModel([{ match: "你好", steps: [{ text: "你好，要我做什么？" }] }]);
const rp = await launchRealPath();
let error: string | null = null;
const evidence: Record<string, unknown> = {};
try {
  const panel = await rp.attach(await rp.openSidePanel());
  await rp.evaluate(panel, `chrome.storage.local.set(${JSON.stringify({ inproc_model_config: { provider: "custom", modelId: "fixture", baseUrl: model.baseUrl }, "inproc_cred:custom": { type: "api_key", key: "local-fixture" } })}).then(()=>true)`);
  await until(async () => await rp.evaluate(panel, 'document.querySelector("#conversation-new")?.disabled===false && document.querySelector("#send-btn")?.disabled===false') || undefined, 60_000, "侧栏就绪");
  const video = 'document.querySelector("#starter-demo")';
  const read = () => rp.evaluate(panel, `(()=>{const v=${video},i=document.querySelector("#input").getBoundingClientRect();if(!v)return null;const r=v.getBoundingClientRect();return {w:r.width,h:r.height,bottom:r.bottom,inputTop:i.top,time:v.currentTime,paused:v.paused,muted:v.muted,shown:v.offsetParent!==null,poster:v.poster.endsWith(".jpg")}})()`) as Promise<{ w: number; h: number; bottom: number; inputTop: number; time: number; paused: boolean; muted: boolean; shown: boolean; poster: boolean } | null>;
  const first = await until(async () => { const v = await read(); return v?.shown && v.h > 80 && !v.paused ? v : undefined; }, 15_000, "空白会话里演示在播放");
  await sleep(1200);
  const later = (await read())!;
  evidence.playing = { first, later };
  assert.ok(later.time !== first.time, "画面在动");
  assert.ok(later.muted, "没有声音");
  assert.ok(later.bottom <= later.inputTop, "不挡输入框");
  await rp.screenshot(panel, join(out, "1-empty.png"));
  await rp.cdp.send("Emulation.setEmulatedMedia", { features: [{ name: "prefers-reduced-motion", value: "reduce" }] }, panel);
  await until(async () => (await read())?.paused || undefined, 5_000, "减少动态效果时停下");
  const still = (await read())!;
  assert.ok(still.poster && still.shown, "减少动态效果时留静态画面");
  await rp.screenshot(panel, join(out, "2-reduced.png"));
  await rp.cdp.send("Emulation.setEmulatedMedia", { features: [{ name: "prefers-reduced-motion", value: "no-preference" }] }, panel);
  await until(async () => (await read())?.paused === false || undefined, 5_000, "恢复后接着播");
  await rp.click(panel, "#input"); await rp.typeText(panel, "你好"); await rp.pressEnter(panel);
  await until(async () => (await rp.evaluate(panel, 'document.querySelector("#messages")?.innerText ?? ""') as string).includes("要我做什么") || undefined, 30_000, "能直接发消息");
  await until(async () => { const v = await read(); return v && !v.shown && v.paused ? true : undefined; }, 5_000, "发出消息后不再显示也不再播放");
  await rp.screenshot(panel, join(out, "3-sent.png"));
  await rp.cdp.send("Page.reload", {}, panel);
  await until(async () => (await rp.evaluate(panel, 'document.querySelector("#messages")?.innerText ?? ""') as string).includes("要我做什么") || undefined, 30_000, "重开侧栏后对话还在");
  await sleep(1000);
  assert.equal((await read())?.shown ?? false, false, "回看已有会话不显示演示");
  await rp.evaluate(panel, `(()=>{${video}.src="demo/missing.webm";return true})()`);
  await until(async () => (await read()) === null || undefined, 5_000, "视频加载不了时直接去掉");
} catch (caught) { error = caught instanceof Error ? caught.message : String(caught); }
await writeFile(join(out, "result.json"), JSON.stringify({ status: error ? "FAIL" : "PASS", error, evidence, dependency: "real isolated extension and side panel; scripted model" }, null, 2));
console.log(JSON.stringify({ status: error ? "FAIL" : "PASS", error, evidence, out }));
await rp.close(); await rp.remove(); await model.close();
process.exit(error ? 1 : 0);
