/** Real isolated extension: paragraph mapping, mode changes, document identity, and original DOM. */
import assert from 'node:assert/strict';
import {mkdir, writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {launchIsolatedExtension, until} from './isolated-extension.mts';
if (!process.argv.includes('--headless')) throw new Error('Required: --headless');
const out=resolve('docs/evals/20260916-page-translation');
await mkdir(out,{recursive:true});
const iso=await launchIsolatedExtension({fixtureHtml:`<!doctype html><html lang="en"><meta charset="utf-8"><title>A quieter way to read</title><style>body{max-width:680px;margin:60px auto;padding:24px;color:#262522;background:#faf9f6;font:18px/1.65 Georgia,serif}h1{font-size:36px;line-height:1.15}a{color:#285f86}p{margin:24px 0}</style><main><h1>A quieter way to read</h1><p id="first">Read <a id="link" href="#source">the source</a> before drawing a conclusion.</p><p id="second">Good tools leave room for your own judgment.</p><p id="third">You can always return to the original text.</p><pre>const untouched = true;</pre><div contenteditable="true">Editable draft stays unchanged.</div><p hidden>Hidden stays unchanged.</p><button id="button">Save</button></main><script>window.clicks=0;document.querySelector('#link').addEventListener('click',()=>window.clicks++);window.originalLink=document.querySelector('#link');window.originalNode=document.querySelector('#second').firstChild;</script></html>`});
const cases:string[]=[];
try{
 const target=await iso.newTarget(iso.fixtureOrigin+'/article');
 const tab=await until(async()=>{const tabs=await iso.swEval('chrome.tabs.query({})') as any[];return tabs.find(t=>t.url===iso.fixtureOrigin+'/article');},5000,'fixture tab');
 await until(async()=>await iso.evalIn(target,'document.readyState==="complete"')||undefined,5000,'fixture ready');
 const sw=await iso.tool('switch_tab',{tabId:tab.id});assert(sw.ok,JSON.stringify(sw));
 const page=(expression:string)=>iso.evalIn(target,expression);
 const call=async(params:any)=>{const r=await iso.tool('page_translation',{tabId:tab.id,...params});assert(r.ok,JSON.stringify(r));return r.data;};
 const original=await page('document.querySelector("main").innerHTML');
 let r=await call({action:'begin'});assert.equal(r.mode,'bilingual');
 r=await call({action:'collect',document:r.document});assert.equal(r.remaining,4);
 const token=r.document;
 const dictionary:Record<string,string>={'A quieter way to read':'安静一点地阅读','Read ':'阅读','the source':'原始资料',' before drawing a conclusion.':'，再得出结论。','Good tools leave room for your own judgment.':'好的工具为你自己的判断留出空间。','You can always return to the original text.':'你随时可以恢复原文。'};
 const translations=r.blocks.flatMap((b:any)=>b.segments.map((s:any)=>{assert(dictionary[s.text],s.text);return{id:s.id,text:dictionary[s.text]};}));
 r=await call({action:'apply',document:token,translations});assert.equal(r.translated,4);assert.equal(r.remaining,0);
 assert.equal(await page('document.querySelectorAll("[data-bys-translation]").length'),4);
 assert.equal(await page('document.querySelector("#second").firstChild.data'),'Good tools leave room for your own judgment.');
 await iso.screenshot(target,out+'/bilingual.png');cases.push('bilingual paragraph insertion; excludes code, editable, hidden and buttons');
 r=await call({action:'display',mode:'translated'});assert.equal(r.mode,'translated');
 assert.equal(await page('document.querySelectorAll("[data-bys-translation]").length'),0);
 assert.equal(await page('document.querySelector("#second").firstChild.data'),'好的工具为你自己的判断留出空间。');
 assert.equal(await page('document.querySelector("#link")===window.originalLink && document.querySelector("#second").firstChild===window.originalNode'),true);
 await page('document.querySelector("#link").click()');assert.equal(await page('window.clicks'),1);
 // Anchor navigation changes the URL but not the document. Keep page translation across fragments.
 await iso.screenshot(target,out+'/translated.png');cases.push('translated-only preserves original text nodes, links and event listeners');
 r=await call({action:'display',mode:'bilingual',fontSize:22});assert.equal(r.translated,4);
 assert.equal(await page('getComputedStyle(document.querySelector("#second [data-bys-translation]")).fontSize'),'22px');
 r=await call({action:'collect',document:token});assert.equal(r.blocks.length,0);cases.push('switch back and resize without new translation');
 await call({action:'display',mode:'translated',fontSize:24});
 assert.equal(await page('getComputedStyle(document.querySelector("#second")).fontSize'),'24px');
 await call({action:'restore'});
 const actual=await page('document.querySelector("main").innerHTML');
 assert.equal(actual,original);cases.push('restore exact original markup');
 // A partial batch is visible before the remaining paragraphs finish. The next mode is used on arrival.
 r=await call({action:'begin'});r=await call({action:'collect',document:r.document});
 const partialToken=r.document;
 const firstBatch=r.blocks[0].segments.map((s:any)=>({id:s.id,text:dictionary[s.text]}));
 await call({action:'apply',document:partialToken,translations:firstBatch});
 assert.equal(await page('document.querySelectorAll("[data-bys-translation]").length'),1);
 r=await call({action:'display',mode:'translated'});
 r=await call({action:'collect',document:partialToken});assert.equal(r.remaining,3);
 await call({action:'apply',document:partialToken,translations:r.blocks.flatMap((b:any)=>b.segments.map((s:any)=>({id:s.id,text:dictionary[s.text]})))});
 assert.equal(await page('document.querySelectorAll("[data-bys-translation]").length'),0);
 assert.match(await page('document.querySelector("#second").textContent'),/好的工具/);
 await call({action:'restore'});cases.push('partial results appear early; remaining batch adopts new mode without retranslating completed blocks');
 const stale=await iso.tool('page_translation',{tabId:tab.id,action:'apply',document:token,translations});assert.equal(stale.ok,false);cases.push('restored document rejects late batch');
 r=await call({action:'begin',mode:'translated'});r=await call({action:'collect',document:r.document});
 const oldToken=r.document, oldTranslations=r.blocks.flatMap((b:any)=>b.segments.map((s:any)=>({id:s.id,text:dictionary[s.text]})));
 await page('document.querySelector("#second").firstChild.data="The page has changed."');
 const changed=await iso.tool('page_translation',{tabId:tab.id,action:'apply',document:oldToken,translations:oldTranslations});assert.equal(changed.ok,false);
 assert.equal(await page('document.querySelector("#second").firstChild.data'),'The page has changed.');cases.push('source mutation rejects stale batch without overwriting new text');
 r=await call({action:'collect',document:oldToken});assert(r.blocks.some((b:any)=>b.segments.some((s:any)=>s.text==='The page has changed.')));
 await page('document.querySelector("main").insertAdjacentHTML("beforeend","<p>Newly loaded text.</p>")');
 r=await call({action:'collect',document:oldToken});assert(r.blocks.some((b:any)=>b.segments.some((s:any)=>s.text==='Newly loaded text.')));cases.push('incremental collection includes updated and newly loaded text');
 await page('location.href="/next"');
 await new Promise(r=>setTimeout(r,400));
 const navigated=await iso.tool('page_translation',{tabId:tab.id,action:'apply',document:oldToken,translations:oldTranslations});assert.equal(navigated.ok,false);cases.push('navigation rejects old document result');
 await writeFile(out+'/browser-results.json',JSON.stringify({passed:true,cases},null,2));
 console.log(JSON.stringify({passed:true,cases,out},null,2));
}finally{await iso.close();}
